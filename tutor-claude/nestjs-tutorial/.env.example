# ============================================================================
# .env.example — 환경변수 템플릿
# ----------------------------------------------------------------------------
# 사용법: 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 절대 커밋하지 않습니다(.gitignore 에 포함).
# 실무에서는 이 값들을 AWS Secrets Manager / Vault / k8s Secret 등으로 주입합니다.
# ============================================================================

# --- 앱 ---
NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- 데이터베이스 (SQLite: 파일 경로) ---
DB_DATABASE=data/dev.sqlite
# 개발 중에만 true. 운영에서는 반드시 false + 마이그레이션 사용
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- JWT ---
# openssl rand -hex 32 등으로 충분히 긴 랜덤 값을 사용하세요
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# --- 보안 / 요청 제한 ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- 캐시 ---
CACHE_TTL=5000
